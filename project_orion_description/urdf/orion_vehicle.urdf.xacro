<?xml version="1.0"?>
<robot name="orion_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Chassis Properties ==================== -->
  <xacro:property name="chassis_length" value="0.70"/>
  <xacro:property name="chassis_width" value="0.35"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass" value="5.0"/>

  <!-- ==================== Wheel Properties ==================== -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- ==================== Layout Properties ==================== -->
  <xacro:property name="wheelbase" value="0.45"/>
  <xacro:property name="track_width" value="0.32"/>

  <!-- Ground clearance: distance from ground to base_link origin -->
  <xacro:property name="ground_clearance" value="${wheel_radius}"/>

  <!-- ==================== Materials ==================== -->
  <material name="orion_body_color">
    <color rgba="0.1 0.1 0.6 1.0"/>
  </material>
  <material name="orion_wheel_color">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
<!-- ==================== Wheel Macro ==================== -->
  <xacro:macro name="orion_wheel" params="prefix parent_link xyz">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="orion_wheel_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <!-- ==================== base_link (chassis) ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="orion_body_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(1/12) * chassis_mass * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        iyy="${(1/12) * chassis_mass * (chassis_length*chassis_length + chassis_height*chassis_height)}"
        izz="${(1/12) * chassis_mass * (chassis_length*chassis_length + chassis_width*chassis_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

<!-- ==================== Rear Wheels (no steering) ==================== -->
  <xacro:orion_wheel
    prefix="rear_left"
    parent_link="base_link"
    xyz="${-wheelbase/2} ${track_width/2} ${-ground_clearance}"/>

  <xacro:orion_wheel
    prefix="rear_right"
    parent_link="base_link"
    xyz="${-wheelbase/2} ${-track_width/2} ${-ground_clearance}"/>

    <!-- ==================== Steering Wheel Macro (front wheels) ==================== -->
  <xacro:macro name="orion_steering_wheel" params="prefix parent_link xyz">
    <link name="${prefix}_steering_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="${parent_link}"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="10" velocity="2"/>
    </joint>

    <xacro:orion_wheel
      prefix="${prefix}"
      parent_link="${prefix}_steering_link"
      xyz="0 0 0"/>
  </xacro:macro>

<!-- ==================== Front Wheels (steerable) ==================== -->
  <xacro:orion_steering_wheel
    prefix="front_left"
    parent_link="base_link"
    xyz="${wheelbase/2} ${track_width/2} ${-ground_clearance}"/>

  <xacro:orion_steering_wheel
    prefix="front_right"
    parent_link="base_link"
    xyz="${wheelbase/2} ${-track_width/2} ${-ground_clearance}"/>

<!-- ==================== Sensor Mount Properties ==================== -->
  <xacro:property name="lidar_radius" value="0.03"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="camera_size" value="0.03"/>
  <xacro:property name="imu_size" value="0.02"/>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="orion_wheel_color"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LiDAR ==================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="orion_body_color"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Camera ==================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="orion_wheel_color"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2} 0 ${camera_size/2}" rpy="0 0 0"/>
  </joint>
</robot>